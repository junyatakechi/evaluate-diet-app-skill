# 実の値は、プロジェクトのフォルダ直下（起動フォルダ）の .env に書く。プロジェクトのスキルはこの .env を共有する。
# ここに書くのは、IDとURLの実値だけ。同じキーの環境変数があれば、そちらが優先される。
# 目標体重は起動フォルダの diet-goal-weights.json、記録の語彙はこのスキルの conventions/meal-words.json に置く。

# 食事を読むGoogleカレンダーのID(主カレンダーならアカウントのメールアドレス)
DIET_CALENDAR_ID=

# 読むNotionのDBのURL(DBのページのURL)。列は conventions/notion-db.md
# 体重記録(collect-renpho-records-app-skill の記録先と同じ)
DIET_DB_MEASUREMENT_URL=
# Oura の睡眠区間(collect-oura-records-app-skill の記録先と同じ)
DIET_DB_OURA_SLEEP_URL=
# Routine(睡眠時間の自己申告)
DIET_DB_ROUTINE_URL=
# Oura の日次サマリー(collect-oura-records-app-skill の記録先と同じ)
DIET_DB_OURA_DAILY_URL=
